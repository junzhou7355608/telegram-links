{
	admin off
	auto_https off
}

:{$PORT:8000} {
	route {
		@health path /api/healthz
		handle @health {
			reverse_proxy 127.0.0.1:{$INTERNAL_PORT:3000}
		}

		basic_auth {
			{$BASIC_AUTH_USERNAME} {$BASIC_AUTH_PASSWORD_HASH}
		}

		handle /api/* {
			reverse_proxy 127.0.0.1:{$INTERNAL_PORT:3000}
		}

		@admin_root path /admin
		redir @admin_root /admin/ 308

		handle_path /admin/* {
			root * /srv/admin
			try_files {path} /index.html
			file_server
		}

		handle {
			root * /srv/web
			try_files {path} /index.html
			file_server
		}
	}
}
