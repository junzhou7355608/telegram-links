DATABASE_URL=postgresql://telegram_links:telegram_links@localhost:5433/telegram_links?schema=public
# Production migrations can use a direct database endpoint while DATABASE_URL
# uses a pooled endpoint. Leave empty locally to reuse DATABASE_URL.
DIRECT_DATABASE_URL=
HOST=127.0.0.1
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
# Admin login. Generate the bcrypt hash with Caddy's hash-password command.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
ADMIN_AUTH_SESSION_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: openssl rand -base64 32
TELEGRAM_SESSION_ENCRYPTION_KEY=
